<UserControl x:Class="Library.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Каталог книг" Style="{StaticResource SectionTitleStyle}" />
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Автор" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Width="180" Style="{StaticResource ValidatedTextBoxStyle}"
                                 Text="{Binding SearchAuthor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Название" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Width="220" Style="{StaticResource ValidatedTextBoxStyle}"
                                 Text="{Binding SearchTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="ISBN" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Width="160" Style="{StaticResource ValidatedTextBoxStyle}"
                                 Text="{Binding SearchIsbn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Жанр" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Width="190" Height="26"
                                  ItemsSource="{Binding Genres, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedGenre, Mode=TwoWay}" />
                    </StackPanel>
                    <CheckBox Content="Только доступные экземпляры" Margin="0,0,12,4" VerticalAlignment="Bottom"
                              IsChecked="{Binding OnlyAvailable, Mode=TwoWay}" />
                    <Button Content="Сбросить фильтры" VerticalAlignment="Bottom"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ClearFiltersCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" Margin="0,8" Style="{StaticResource ReadOnlyGridStyle}"
                  ItemsSource="{Binding BooksView, Mode=OneWay}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Width="2*" Binding="{Binding Title, Mode=OneWay}" />
                <DataGridTextColumn Header="Автор" Width="*" Binding="{Binding Author, Mode=OneWay}" />
                <DataGridTextColumn Header="ISBN" Width="140" Binding="{Binding Isbn, Mode=OneWay}" />
                <DataGridTextColumn Header="Год" Width="70" Binding="{Binding Year, Mode=OneWay}" />
                <DataGridTextColumn Header="Жанр" Width="160" Binding="{Binding Genre, Mode=OneWay}" />
                <DataGridTextColumn Header="Всего экз." Width="90" Binding="{Binding TotalCopies, Mode=OneWay}" />
                <DataGridTextColumn Header="Свободно" Width="90" Binding="{Binding AvailableCopies, Mode=OneWay}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding CatalogSummary, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить книгу" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddBookCommand}" />
                <Button Content="Изменить" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding EditBookCommand}" />
                <Button Content="Удалить" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteBookCommand}" />
                <Button Content="Импорт из CSV" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ImportCatalogCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>