<UserControl x:Class="Library.App.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Выдача книги" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Книга (в скобках — свободные экземпляры)" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Height="26" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                              ItemsSource="{Binding BookOptions, Mode=OneWay}"
                              SelectedItem="{Binding SelectedBookOption, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} — {1} (свободно: {2})">
                                            <Binding Path="Title" Mode="OneWay" />
                                            <Binding Path="Author" Mode="OneWay" />
                                            <Binding Path="AvailableCopies" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Читатель" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Height="26" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                              ItemsSource="{Binding ReadersView, Mode=OneWay}"
                              SelectedItem="{Binding SelectedReader, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="FullName" Mode="OneWay" />
                                            <Binding Path="TicketNumber" Mode="OneWay" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Дата выдачи" Style="{StaticResource FieldLabelStyle}" />
                            <DatePicker Width="140" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                        SelectedDate="{Binding IssueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Срок, дней" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Width="90" Style="{StaticResource ValidatedTextBoxStyle}"
                                     Text="{Binding TermDaysText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Вернуть до" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock FontWeight="SemiBold" Margin="0,4,0,0" Text="{Binding DueDatePreview, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Оформить выдачу" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding IssueCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Возврат книги" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding SelectedLoanSummary, Mode=OneWay}" TextWrapping="Wrap" />

                    <TextBlock Text="Фактическая дата возврата" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker Width="150" HorizontalAlignment="Left"
                                Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                SelectedDate="{Binding ReturnDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <Button Content="Принять возврат" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ReturnCommand}" />

                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5A6675"
                               Text="Правило штрафа: первые 7 дней просрочки бесплатно, далее 5 единиц за каждый день." />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
            <TextBlock Text="Показать:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="180" Height="26" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}">
                <ComboBoxItem Content="Все выдачи" />
                <ComboBoxItem Content="Только выданные" />
                <ComboBoxItem Content="Только просроченные" />
                <ComboBoxItem Content="Только возвращённые" />
            </ComboBox>
            <TextBlock Text="Поиск по книге или читателю:" VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBox Width="260" Style="{StaticResource ValidatedTextBoxStyle}"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <DataGrid Grid.Row="2" Style="{StaticResource ReadOnlyGridStyle}"
                  ItemsSource="{Binding LoansView, Mode=OneWay}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Книга" Width="2*" Binding="{Binding BookTitle, Mode=OneWay}" />
                <DataGridTextColumn Header="Читатель" Width="*" Binding="{Binding ReaderName, Mode=OneWay}" />
                <DataGridTextColumn Header="Выдана" Width="100" Binding="{Binding IssueDate, Mode=OneWay, StringFormat=dd.MM.yyyy}" />
                <DataGridTextColumn Header="Срок" Width="100" Binding="{Binding DueDate, Mode=OneWay, StringFormat=dd.MM.yyyy}" />
                <DataGridTextColumn Header="Возвращена" Width="110"
                                    Binding="{Binding ReturnDate, Mode=OneWay, Converter={StaticResource NullableDate}}" />
                <DataGridTextColumn Header="Просрочка, дн." Width="110" Binding="{Binding OverdueDays, Mode=OneWay}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{Binding OverdueDays, Mode=OneWay, Converter={StaticResource OverdueToBrush}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Штраф, ед." Width="100" Binding="{Binding Fine, Mode=OneWay, StringFormat=0.##}" />
                <DataGridTextColumn Header="Состояние" Width="170" Binding="{Binding StatusText, Mode=OneWay}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,6,0,0" Foreground="#5A6675"
                   Text="Выдача недоступна без свободных экземпляров; возврат — только для невозвращённой книги." />
    </Grid>
</UserControl>