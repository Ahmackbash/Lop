<Window x:Class="Library.App.Views.BookEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneTime}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Автор" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Style="{StaticResource ValidatedTextBoxStyle}"
                 Text="{Binding Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <TextBlock Text="Название" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Style="{StaticResource ValidatedTextBoxStyle}" TextWrapping="Wrap" Height="44"
                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <TextBlock Text="ISBN (10 или 13 цифр, уникальный)" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Style="{StaticResource ValidatedTextBoxStyle}"
                 Text="{Binding Isbn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <TextBlock Text="Жанр" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox IsEditable="True" Height="26"
                  ItemsSource="{Binding Genres, Mode=OneWay}"
                  Text="{Binding Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Год издания" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Width="110" Style="{StaticResource ValidatedTextBoxStyle}"
                         Text="{Binding YearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Экземпляров" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Width="110" Style="{StaticResource ValidatedTextBoxStyle}"
                         Text="{Binding CopiesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Сохранить" IsDefault="True" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AcceptCommand}" />
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>