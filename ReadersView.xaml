<UserControl x:Class="Library.App.Views.ReadersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Читатели" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Поиск: билет, ФИО или телефон" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Width="320" Style="{StaticResource ValidatedTextBoxStyle}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="Очистить" VerticalAlignment="Bottom"
                            Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ClearSearchCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" Margin="0,8" Style="{StaticResource ReadOnlyGridStyle}"
                  ItemsSource="{Binding ReadersView, Mode=OneWay}"
                  SelectedItem="{Binding SelectedReader, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ билета" Width="120" Binding="{Binding TicketNumber, Mode=OneWay}" />
                <DataGridTextColumn Header="ФИО" Width="2*" Binding="{Binding FullName, Mode=OneWay}" />
                <DataGridTextColumn Header="Телефон" Width="*" Binding="{Binding Phone, Mode=OneWay}" />
                <DataGridTextColumn Header="Дата регистрации" Width="150"
                                    Binding="{Binding RegistrationDate, Mode=OneWay, StringFormat=dd.MM.yyyy}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding ReadersSummary, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить читателя" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddReaderCommand}" />
                <Button Content="Изменить" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding EditReaderCommand}" />
                <Button Content="Удалить" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteReaderCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>