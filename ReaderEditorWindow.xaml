<Window x:Class="Library.App.Views.ReaderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, Mode=OneTime}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Номер читательского билета" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Style="{StaticResource ValidatedTextBoxStyle}"
                 Text="{Binding TicketNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <TextBlock Text="ФИО" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Style="{StaticResource ValidatedTextBoxStyle}"
                 Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <TextBlock Text="Телефон" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Style="{StaticResource ValidatedTextBoxStyle}"
                 Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <TextBlock Text="Дата регистрации" Style="{StaticResource FieldLabelStyle}" />
        <DatePicker Width="160" HorizontalAlignment="Left"
                    Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                    SelectedDate="{Binding RegistrationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Сохранить" IsDefault="True" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AcceptCommand}" />
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>