<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Library.App.ViewModels"
                    xmlns:views="clr-namespace:Library.App.Views">

    <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
        <views:CatalogView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReadersViewModel}">
        <views:ReadersView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LoansViewModel}">
        <views:LoansView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <views:ReportsView />
    </DataTemplate>

</ResourceDictionary>